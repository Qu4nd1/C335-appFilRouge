<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nouvel ingrédient"
    x:Class="appFilRouge.NewIngredient"
    BackgroundColor="#FBFAF6">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="18">
            <Button Text="‹  Retour" HorizontalOptions="Start" Padding="0"
                    BackgroundColor="Transparent" TextColor="#315246" />
            <VerticalStackLayout Spacing="4">
                <Label Text="NEW ELEMENT" FontSize="11" FontAttributes="Bold" TextColor="#668071" CharacterSpacing="1.5" />
                <Label Text="Add an ingredient" FontSize="29" FontAttributes="Bold" TextColor="#183D33" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="7">
                <Label Text="Name of the ingredient" FontAttributes="Bold" TextColor="#315246" />
                <Border Padding="14,6" BackgroundColor="#FFFFFF" Stroke="#D9DDD6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Ex: Avocado" MaxLength="50" TextColor="#183D33" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="7">
                <Label Text="Calories / 100 g" FontAttributes="Bold" TextColor="#315246" />
                <Border Padding="14,6" BackgroundColor="#FFFFFF" Stroke="#D9DDD6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Ex: 160" Keyboard="Numeric" TextColor="#183D33" />
                        <Label Grid.Column="1" Text="kcal" VerticalOptions="Center" TextColor="#78827D" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="7">
                <Label Text="Proteins / 100 g" FontAttributes="Bold" TextColor="#315246" />
                <Border Padding="14,6" BackgroundColor="#FFFFFF" Stroke="#D9DDD6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Ex: 2" Keyboard="Numeric" TextColor="#183D33" />
                        <Label Grid.Column="1" Text="g" VerticalOptions="Center" TextColor="#78827D" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- A intégrer logique métier pour affichage du message si valeurs pas ok ou bizarre-->
            <!--<Label Text="✓  Les valeurs saisies sont valides." Padding="14"
                   BackgroundColor="#EEF4D7" TextColor="#315246" FontSize="12" /> -->
            <Button Text="Save the ingredient" Clicked="SaveIngredient" Padding="16" CornerRadius="12"
                    BackgroundColor="#19483B" TextColor="#FFFFFF" FontAttributes="Bold" />
            <Button Text="Cancel" Clicked="CancelButton" BackgroundColor="Transparent" TextColor="#668071" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>