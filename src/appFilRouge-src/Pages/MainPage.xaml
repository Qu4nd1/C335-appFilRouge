<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appFilRouge.MainPage"
    Title="Ingrédients"
    BackgroundColor="#FBFAF6">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,28" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="MY LIBRARY" FontSize="11" FontAttributes="Bold" TextColor="#668071" CharacterSpacing="1.5" />
                        <Label Text="Ingredients" FontSize="30" FontAttributes="Bold" TextColor="#183D33" />
                    </VerticalStackLayout>
                    <Button x:Name="AddButton" Clicked="AddButtonClicked" Grid.Column="1" Text="+" FontSize="24" WidthRequest="48" HeightRequest="48"
                            CornerRadius="24" BackgroundColor="#DDECAA" TextColor="#183D33" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <SearchBar x:Name="MainSearchBar"  Placeholder="Search an ingredient" BackgroundColor="#FFFFFF"
                           TextColor="#183D33" PlaceholderColor="#89908C" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="MY INGREDIENTS" FontSize="11" FontAttributes="Bold" TextColor="#668071" />
                    <Label Grid.Column="1" Text="4" FontSize="11" FontAttributes="Bold" TextColor="#183D33" />
                </Grid>

                <Border Padding="16" BackgroundColor="#FFFFFF" Stroke="#E7E5DE" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,10" ColumnDefinitions="48,*,Auto">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#F2B86B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>
                                <Label Text="PO" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Chicken" FontAttributes="Bold" TextColor="#183D33" />
                                <Label Text="165 kcal · 31 g prot. / 100 g" FontSize="12" TextColor="#78827D" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#89908C" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EEECE6" />
                        <Grid Padding="0,10" ColumnDefinitions="48,*,Auto">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#D9C39E" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>
                                <Label Text="RI" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Brown Rice" FontAttributes="Bold" TextColor="#183D33" />
                                <Label Text="130 kcal · 2,7 g prot. / 100 g" FontSize="12" TextColor="#78827D" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#89908C" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EEECE6" />
                        <Grid Padding="0,10" ColumnDefinitions="48,*,Auto">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#9BBF7A" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>
                                <Label Text="BR" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Brokkoli" FontAttributes="Bold" TextColor="#183D33" />
                                <Label Text="34 kcal · 2,8 g prot. / 100 g" FontSize="12" TextColor="#78827D" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#89908C" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EEECE6" />
                        <Grid Padding="0,10" ColumnDefinitions="48,*,Auto">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#EBC45C" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>
                                <Label Text="EG" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Eggs" FontAttributes="Bold" TextColor="#183D33" />
                                <Label Text="143 kcal · 12,6 g prot. / 100 g" FontSize="12" TextColor="#78827D" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#89908C" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Les valeurs sont calculées pour 100 g." Padding="14"
                       BackgroundColor="#EEF4D7" TextColor="#315246" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>