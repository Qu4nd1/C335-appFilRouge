<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:appFilRouge.ViewModels"
    xmlns:models="clr-namespace:appFilRouge.Models"
    xmlns:conv="clr-namespace:appFilRouge.Converters"
    x:Class="appFilRouge.MainPage"
    x:DataType="vm:IngredientsViewModel"
    Title="Ingrédients"
    BackgroundColor="#FBFAF6">
    
    <ContentPage.Resources>
        <conv:NameToColorConverter x:Key="NameToColor" />
    </ContentPage.Resources>
    
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="24,28" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="MY LIBRARY" FontSize="11" FontAttributes="Bold" TextColor="#668071" CharacterSpacing="1.5" />
                        <Label Text="Ingredients" FontSize="30" FontAttributes="Bold" TextColor="#183D33" />
                    </VerticalStackLayout>
                    <Button x:Name="AddButton" Command="{Binding AddCommand}" Grid.Column="1" Text="+" FontSize="24" WidthRequest="48" HeightRequest="48"
                            CornerRadius="24" BackgroundColor="#DDECAA" TextColor="#183D33" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <SearchBar x:Name="MainSearchBar" Text="{Binding SearchText}"  Placeholder="Search an ingredient" BackgroundColor="#FFFFFF"
                           TextColor="#183D33" PlaceholderColor="#89908C" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="MY INGREDIENTS" FontSize="11" FontAttributes="Bold" TextColor="#668071" />
                    <Label Grid.Column="1" Text="{Binding Ingredients.Count}" FontSize="11" FontAttributes="Bold" TextColor="#183D33" />
                </Grid>

                <Border Padding="16" BackgroundColor="#FFFFFF" Stroke="#E7E5DE" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <CollectionView ItemsSource="{Binding Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Ingredient">
                                <Grid RowDefinitions="Auto,1">

                                    <!-- the row -->
                                    <Grid Padding="0,10" ColumnDefinitions="48,*,Auto">
                                        <Border WidthRequest="38" HeightRequest="38"
                                            HorizontalOptions="Start" VerticalOptions="Center"
                                            BackgroundColor="{Binding Name, Converter={StaticResource NameToColor}}"
                                            StrokeThickness="0">    
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="19" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center"
                                                FontSize="11" FontAttributes="Bold" TextColor="#183D33" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#183D33" />
                                            <Label FontSize="12" TextColor="#78827D">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding CaloriesPer100g, StringFormat='{0:0.#} kcal'}" TextColor="#78827D" />
                                                        <Span Text="{Binding ProteinsPer100g, StringFormat='  ·  {0:0.#} g prot. / 100 g'}" TextColor="#78827D" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#89908C" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- the separator line -->
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="#EEECE6" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Label Text="Les valeurs sont calculées pour 100 g." Padding="14"
                       BackgroundColor="#EEF4D7" TextColor="#315246" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>